<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.controller.VendedorController">
    <children>
        <VBox spacing="16" AnchorPane.topAnchor="14" AnchorPane.leftAnchor="14" AnchorPane.rightAnchor="14" AnchorPane.bottomAnchor="14">
            <children>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel-header-green">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblBienvenida" text="Panel del Vendedor" style="-fx-text-fill:white; -fx-font-size:26px; -fx-font-weight:bold;"/>
                                <Label text="Resumen rápido de tu actividad y accesos directos a ventas." styleClass="muted"/>
                            </children>
                        </VBox>
                        <Button text="Refrescar" onAction="#refrescar" styleClass="btn-ghost"/>
                        <Button text="Nueva Venta" onAction="#abrirVentas" styleClass="btn-success" style="-fx-background-color:rgba(255,255,255,0.22); -fx-text-fill:white; -fx-font-weight:bold; -fx-border-color:rgba(255,255,255,0.35); -fx-border-radius:10; -fx-background-radius:10;"/>
                        <Button text="Comprobantes" onAction="#abrirComprobantes" styleClass="btn-ghost"/>
                    </children>
                </HBox>

                <HBox spacing="12">
                    <children>
                        <VBox spacing="4" prefWidth="190" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-blue">
                            <children>
                                <Label text="VENTAS HOY" styleClass="stat-title"/>
                                <Label fx:id="lblVentasHoy" text="0" styleClass="stat-value" style="-fx-text-fill:#2563eb;"/>
                                <Label text="Operaciones del día" styleClass="muted"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" prefWidth="210" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-green">
                            <children>
                                <Label text="TOTAL VENDIDO HOY" styleClass="stat-title"/>
                                <Label fx:id="lblTotalHoy" text="S/ 0.00" styleClass="stat-value" style="-fx-text-fill:#059669; -fx-font-size:24px;"/>
                                <Label text="Ingresos del día" styleClass="muted"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" prefWidth="180" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-purple">
                            <children>
                                <Label text="MIS VENTAS" styleClass="stat-title"/>
                                <Label fx:id="lblMisVentas" text="0" styleClass="stat-value" style="-fx-text-fill:#7c3aed;"/>
                                <Label text="Histórico personal" styleClass="muted"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" prefWidth="170" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-orange">
                            <children>
                                <Label text="ANULADAS HOY" styleClass="stat-title"/>
                                <Label fx:id="lblAnuladasHoy" text="0" styleClass="stat-value" style="-fx-text-fill:#d97706;"/>
                                <Label text="Ventas anuladas" styleClass="muted"/>
                            </children>
                        </VBox>
                        <VBox spacing="4" prefWidth="190" HBox.hgrow="ALWAYS" styleClass="stat-card, stat-teal">
                            <children>
                                <Label text="TICKET PROMEDIO" styleClass="stat-title"/>
                                <Label fx:id="lblTicketProm" text="S/ 0.00" styleClass="stat-value" style="-fx-text-fill:#0f766e; -fx-font-size:24px;"/>
                                <Label text="Promedio por venta" styleClass="muted"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="12" VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding:18;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Mis últimas ventas" styleClass="section-title">
                                            <font><Font name="System Bold" size="16"/></font>
                                        </Label>
                                        <Label text="Historial reciente de tus operaciones." styleClass="muted"/>
                                    </children>
                                </VBox>
                                <Label text="ACTUALIZADO" styleClass="badge, badge-green"/>
                            </children>
                        </HBox>
                        <TableView fx:id="tableVentas" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="160"/>
                                <TableColumn fx:id="colSerie" text="Serie" prefWidth="90"/>
                                <TableColumn fx:id="colNumero" text="Número" prefWidth="120"/>
                                <TableColumn fx:id="colTotal" text="Total" prefWidth="110"/>
                                <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                            </columns>
                            <placeholder><Label text="No hay ventas para mostrar." styleClass="muted"/></placeholder>
                        </TableView>
                        <Label fx:id="lblMsg" text="Listo." style="-fx-text-fill:#166534; -fx-font-weight:bold;"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>