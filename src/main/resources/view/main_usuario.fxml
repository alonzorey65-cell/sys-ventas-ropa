<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.controller.UsuarioController">
  <children>
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
      <Label text="Gestión de Usuarios"><font><Font name="System Bold" size="20"/></font></Label>
      <HBox spacing="10">
        <VBox spacing="8" prefWidth="320">
          <Label text="Usuario"/><TextField fx:id="txtUsuario" promptText="Nombre de usuario"/>
          <Label text="Clave"/><PasswordField fx:id="txtClave" promptText="Clave"/>
          <Label text="Perfil"/><ComboBox fx:id="cbxPerfil" prefWidth="320"/>
          <HBox spacing="8"><Button text="Guardar" onAction="#guardar"/><Button text="Limpiar" onAction="#limpiar"/><Button text="Eliminar" onAction="#eliminar"/></HBox>
          <Label fx:id="lblMsg" text="Listo."/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
          <HBox spacing="8"><Label text="Filtrar:"/><TextField fx:id="txtFiltro" promptText="Buscar usuario..."/><Button text="Refrescar" onAction="#listar"/></HBox>
          <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns><TableColumn fx:id="colId" text="ID" prefWidth="70"/><TableColumn fx:id="colUsuario" text="Usuario" prefWidth="220"/><TableColumn fx:id="colPerfil" text="Perfil ID" prefWidth="100"/></columns>
          </TableView>
        </VBox>
      </HBox>
    </VBox>
  </children>
</AnchorPane>
