<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.controller.VentaController">
    <children>
        <VBox spacing="14" AnchorPane.topAnchor="14" AnchorPane.leftAnchor="14" AnchorPane.rightAnchor="14" AnchorPane.bottomAnchor="14">
            <children>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel-header-green">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Punto de Venta / Registro de Venta" style="-fx-text-fill:white; -fx-font-size:26px; -fx-font-weight:bold;"/>
                                <Label text="Busca cliente, agrega productos al carrito y registra la venta rápidamente." styleClass="muted"/>
                            </children>
                        </VBox>
                        <Label text="POS" style="-fx-background-color:rgba(255,255,255,0.2); -fx-text-fill:white; -fx-background-radius:20; -fx-padding:4 12; -fx-font-weight:bold;"/>
                    </children>
                </HBox>

                <!-- Cliente -->
                <VBox spacing="10" styleClass="card" style="-fx-padding:16;">
                    <children>
                        <Label text="Datos del cliente" styleClass="section-title">
                            <font><Font name="System Bold" size="15"/></font>
                        </Label>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="220.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="220.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Buscar cliente" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="autocompCliente" onAction="#buscarClienteCdni" promptText="Buscar por DNI/RUC" GridPane.rowIndex="1" />
                                <Button fx:id="btnFormCliente" maxWidth="Infinity" mnemonicParsing="false" onAction="#buscarClienteCdni" text="Buscar"
                                        styleClass="btn-secondary" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="DNI / RUC" GridPane.columnIndex="2" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="dniRuc" onAction="#buscarClienteCdni" promptText="DNI/RUC y Enter" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                <Label text="Nombre / Razón Social" GridPane.columnIndex="3" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="razonSocial" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="Dirección" GridPane.columnIndex="4" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="txtDireccion" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                                <Button fx:id="btnRegCliente" maxWidth="Infinity" mnemonicParsing="false" onAction="#guardarCliente" text="Add"
                                        styleClass="btn-success" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Producto -->
                <VBox spacing="10" styleClass="card" style="-fx-padding:16;">
                    <children>
                        <Label text="Agregar producto" styleClass="section-title">
                            <font><Font name="System Bold" size="15"/></font>
                        </Label>
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="170.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="170.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="110.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="110.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="90.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Buscar Producto" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="autocompProducto" GridPane.rowIndex="1" />

                                <Label text="Producto" GridPane.columnIndex="1" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="nombreProducto" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Código" GridPane.columnIndex="2" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="codigoPro" editable="false" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                <Label text="Stock" GridPane.columnIndex="3" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="stockPro" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="Cantidad" GridPane.columnIndex="4" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="cantidadPro" onKeyTyped="#calcularPT" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                                <Label text="P. Unit" GridPane.columnIndex="5" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="punitPro" GridPane.columnIndex="5" GridPane.rowIndex="1"/>

                                <Label text="P. Total" GridPane.columnIndex="6" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="preTPro" editable="false" GridPane.columnIndex="6" GridPane.rowIndex="1"/>

                                <Button fx:id="btnRegCarrito" maxWidth="Infinity" mnemonicParsing="false" onAction="#registarPCarrito" text="Add"
                                        styleClass="btn-success" GridPane.columnIndex="7" GridPane.rowIndex="1"/>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- Carrito -->
                <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card" style="-fx-padding:16;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label text="Carrito de venta" styleClass="section-title">
                                    <font><Font name="System Bold" size="15"/></font>
                                </Label>
                                <Label text="Revisa los productos antes de registrar" styleClass="muted"/>
                            </children>
                        </HBox>
                        <TableView fx:id="tableView" VBox.vgrow="ALWAYS" prefHeight="220.0"/>
                    </children>
                </VBox>

                <!-- Totales -->
                <VBox spacing="10" styleClass="card" style="-fx-padding:16;">
                    <children>
                        <GridPane hgap="12" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="140.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="160.0" />
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="200.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Base imponible" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="txtBaseImp" editable="false" GridPane.rowIndex="1" />

                                <Label text="IGV" GridPane.columnIndex="1" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="txtIgv" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Descuento" GridPane.columnIndex="2" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="txtDescuento" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                                <Label text="Importe Total S/." GridPane.columnIndex="3" style="-fx-font-weight:bold;"/>
                                <TextField fx:id="txtImporteT" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1"
                                           style="-fx-font-size:14px; -fx-font-weight:bold;"/>

                                <VBox spacing="8" GridPane.columnIndex="4" GridPane.rowSpan="2">
                                    <children>
                                        <Button fx:id="btnRegVenta" maxWidth="Infinity" mnemonicParsing="false" onAction="#registrarVenta"
                                                text="Registrar Venta" styleClass="btn-success" style="-fx-padding:10 16;"/>
                                        <Button fx:id="btnGenerarComprobante" maxWidth="Infinity" mnemonicParsing="false" onAction="#generarComprobante"
                                                text="Comprobante" styleClass="btn-secondary" style="-fx-padding:10 16;"/>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>