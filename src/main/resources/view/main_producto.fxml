<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.controller.ProductoController">
    <children>
        <VBox spacing="16" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
            <children>
                <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel-header">
                    <children>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Gestión de Productos" style="-fx-text-fill:white; -fx-font-size:26px; -fx-font-weight:bold;"/>
                                <Label text="Controla catálogo, precios, stock y clasificación de productos." styleClass="muted"/>
                            </children>
                        </VBox>
                        <Label text="INVENTARIO" style="-fx-background-color:rgba(255,255,255,0.2); -fx-text-fill:white; -fx-background-radius:20; -fx-padding:4 10; -fx-font-weight:bold;"/>
                    </children>
                </HBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox spacing="12" prefWidth="460" minWidth="420" styleClass="card" style="-fx-padding:18;">
                            <children>
                                <Label text="Registro de producto" styleClass="section-title">
                                    <font><Font name="System Bold" size="15"/></font>
                                </Label>

                                <GridPane vgap="10" hgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="90.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Nombre" GridPane.rowIndex="0" style="-fx-font-weight:bold;"/>
                                        <TextField fx:id="txtNombreProducto" promptText="Ej. Polo Oversize" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="0" />

                                        <Label text="Precio" GridPane.rowIndex="1" style="-fx-font-weight:bold;"/>
                                        <TextField fx:id="txtPUnit" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <Label text="Stock" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight:bold;"/>
                                        <TextField fx:id="txtStock" promptText="Cantidad" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                        <Label text="Categoría" GridPane.rowIndex="2" style="-fx-font-weight:bold;"/>
                                        <ComboBox fx:id="cbxCategoria" prefWidth="160.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label text="Marca" GridPane.columnIndex="2" GridPane.rowIndex="2" style="-fx-font-weight:bold;"/>
                                        <ComboBox fx:id="cbxMarca" prefWidth="160.0" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                                        <Label text="Unidad" GridPane.rowIndex="3" style="-fx-font-weight:bold;"/>
                                        <ComboBox fx:id="cbxUnidadMedida" prefWidth="160.0" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    </children>
                                </GridPane>

                                <HBox spacing="8">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#validarFormulario" text="Guardar" styleClass="btn-success" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" styleClass="btn-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                        <Button mnemonicParsing="false" onAction="#eliminarProducto" text="Eliminar" styleClass="btn-danger" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>

                                <Separator/>
                                <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" text="Estado: Listo" wrapText="true"
                                       style="-fx-text-fill:#166534; -fx-font-weight:bold;"/>

                                <!-- Campos ocultos para compatibilidad con controlador anterior -->
                                <TextField fx:id="txtPUnitOld" managed="false" visible="false" />
                                <TextField fx:id="txtUtilidad" managed="false" visible="false" />
                                <TextField fx:id="txtStockOld" managed="false" visible="false" />
                                <ComboBox fx:id="cbxTipoProducto" managed="false" visible="false" />
                            </children>
                        </VBox>

                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="card" style="-fx-padding:18;">
                            <children>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Catálogo de productos" styleClass="section-title">
                                                    <font><Font name="System Bold" size="15"/></font>
                                                </Label>
                                                <Label text="Filtra por nombre y gestiona tu inventario." styleClass="muted"/>
                                            </children>
                                        </VBox>
                                        <TextField fx:id="txtFiltroDato" promptText="Buscar por nombre..." prefWidth="240"/>
                                        <Button mnemonicParsing="false" onAction="#listarProductos" text="Refrescar" styleClass="btn-secondary"/>
                                    </children>
                                </HBox>

                                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                                        <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
                                        <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio" />
                                        <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
                                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                                    </columns>
                                    <placeholder><Label text="No hay productos registrados." styleClass="muted"/></placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>