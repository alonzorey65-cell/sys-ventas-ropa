<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="miContenedor" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.controller.ProductoController">
    <children>
        <VBox layoutX="14.0" layoutY="14.0" spacing="8.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
            <children>
                <AnchorPane>
                    <children>
                        <Label layoutX="14.0" layoutY="14.0" text="Gestión de Productos">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label layoutX="295.0" layoutY="44.0" text="Filtrar Producto" />
                        <TextField fx:id="txtFiltroDato" layoutX="295.0" layoutY="69.0" promptText="Buscar por nombre..." />
                        <Button layoutX="457.0" layoutY="69.0" mnemonicParsing="false" onAction="#listarProductos" text="Refrescar" />
                    </children>
                    <padding>
                        <Insets bottom="5.0" />
                    </padding>
                </AnchorPane>
                <HBox maxHeight="1.7976931348623157E308" spacing="15.0">
                    <children>
                        <AnchorPane>
                            <children>
                                <GridPane layoutY="5.0" vgap="6.0" hgap="6.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="110.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Registro de Producto" GridPane.columnSpan="2147483647">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <Label text="Nombre" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombreProducto" promptText="Ej. Polo Oversize" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                                        <Label text="Precio" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtPUnit" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <Label text="Stock" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtStock" promptText="Cantidad" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                        <Label text="Categoría (ID)" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="cbxCategoria" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                        <Label text="Marca (ID)" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                        <ComboBox fx:id="cbxMarca" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
                                        <Label text="Unidad (ID)" GridPane.rowIndex="4" />
                                        <ComboBox fx:id="cbxUnidadMedida" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                        <HBox spacing="8.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#validarFormulario" text="Guardar" />
                                                <Button mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar" />
                                                <Button mnemonicParsing="false" onAction="#eliminarProducto" text="Eliminar" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lbnMsg" maxWidth="1.7976931348623157E308" text="Estado: Listo" GridPane.columnSpan="2147483647" GridPane.rowIndex="6" />
                                        <!-- Campos ocultos/compatibilidad con controlador anterior -->
                                        <TextField fx:id="txtPUnitOld" managed="false" visible="false" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                                        <TextField fx:id="txtUtilidad" managed="false" visible="false" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                                        <TextField fx:id="txtStockOld" managed="false" visible="false" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                                        <ComboBox fx:id="cbxTipoProducto" managed="false" visible="false" GridPane.columnIndex="3" GridPane.rowIndex="5" />
                                    </children>
                                    <padding>
                                        <Insets left="5.0" right="5.0" />
                                    </padding>
                                </GridPane>
                            </children>
                        </AnchorPane>
                        <AnchorPane HBox.hgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tableView" layoutX="6.0" layoutY="30.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                                        <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                                        <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
                                        <TableColumn fx:id="colCategoria" prefWidth="100.0" text="Categoría" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
