<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.controller.ClienteController">
  <children>
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
      <Label text="Gestión de Clientes"><font><Font name="System Bold" size="20"/></font></Label>
      <HBox spacing="10">
        <VBox spacing="8" prefWidth="340">
          <Label text="DNI/RUC"/><TextField fx:id="txtDniRuc" promptText="8 u 11 dígitos"/>
          <Label text="Nombre / Razón Social"/><TextField fx:id="txtNombre" promptText="Nombre"/>
          <Label text="Dirección"/><TextField fx:id="txtDireccion" promptText="Dirección"/>
          <Label text="Teléfono"/><TextField fx:id="txtTelefono" promptText="Teléfono"/>
          <HBox spacing="8"><Button text="Guardar" onAction="#guardar"/><Button text="Limpiar" onAction="#limpiar"/><Button text="Eliminar" onAction="#eliminar"/></HBox>
          <Label fx:id="lblMsg" text="Listo."/>
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
          <HBox spacing="8"><Label text="Filtrar:"/><TextField fx:id="txtFiltro" promptText="Nombre o DNI/RUC..."/><Button text="Refrescar" onAction="#listar"/></HBox>
          <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="colId" text="ID" prefWidth="60"/><TableColumn fx:id="colDniRuc" text="DNI/RUC" prefWidth="110"/><TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/><TableColumn fx:id="colDireccion" text="Dirección" prefWidth="200"/><TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="100"/>
            </columns>
          </TableView>
        </VBox>
      </HBox>
    </VBox>
  </children>
</AnchorPane>
